# Copy to .env for local overrides. Never commit real values.
# Every secret used by the lab (node keys, TLS and STIR certificates, internal
# tokens, testnet wallets) is generated at startup by lab/bootstrap.

# Receipt service (one per node; the lab sets these per container)
DOTS_NODE_ID=node-a
DOTS_DATABASE_URL=postgresql://dots:dots@pg-a:5432/dots
DOTS_KEY_DIR=/state/node-a/keys
DOTS_PEERS_FILE=/state/peers.json
DOTS_RATE_TABLES_DIR=/state/rates
DOTS_INTERNAL_TOKEN=change-me
DOTS_TLS_CA=/state/ca/ca.pem
DOTS_TLS_CERT=/state/node-a/tls/cert.pem
DOTS_TLS_KEY=/state/node-a/tls/key.pem

# Tolerances and windows (decision D2)
DOTS_TOL_ABS_SECONDS=2
DOTS_TOL_REL_PERMILLE=10
DOTS_TOL_SKEW_MS=2000
DOTS_MATCH_WINDOW_S=60
DOTS_PROPOSAL_WINDOW_S=120
DOTS_COUNTERSIG_WINDOW_S=300

# Lab-only fault injection (never set in production)
DOTS_LAB_MODE=false
DOTS_LAB_SKEW=

# Build behind a TLS-intercepting proxy: path to an extra CA bundle
EXTRA_CA=
